FLASK_ENV=development
PYTHONPATH=src
PROJECT_NAME=DEVELOPMENT in Oracle using AI Lab

# Oracle AI Database 26ai Free local lab placeholders.
# Copy this file to .env and replace ORACLE_PWD locally before starting Docker.
ORACLE_IMAGE=container-registry.oracle.com/database/free:latest
ORACLE_PWD=change_me_in_local_env
ORACLE_HOST_PORT=1521
ORACLE_PDB=FREEPDB1
BACKUP_ROOT=backups/oracle-dev-ai-lab
